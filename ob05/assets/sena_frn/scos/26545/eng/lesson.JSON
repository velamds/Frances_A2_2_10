"text\\\", \\\"content\\\": \\\"nous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"dirons\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"direz\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ils/elles\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"diront\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "On utilise \u00e9galement le verbe <span class=\"strong\">promettre</span> au <span class=\"strong\">pr\u00e9sent de l'indicatif</span>. Pour cela, il faut faire pr\u00e9c\u00e9der le verbe d'un pronom compl\u00e9ment d'objet direct. ", "type": "text"}, {"content": "Je vous promets que je vous dirai tout ce qui s'est pass\u00e9.", "type": "example"}, {"content": "Je te promets que cela n'arrivera plus jamais.", "type": "example"}, {"content": "Lorsque l'on veut demander \u00e0 quelqu'un de nous promettre quelque chose, alors on utilise le verbe <span class=\"strong\">promettre</span> \u00e0 l'<span class=\"strong\">imp\u00e9ratif</span>.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Les \u00e9motions", "type": "heading"}, {"content": "Les \u00e9motions sont des r\u00e9actions affectives aux \u00e9v\u00e9nements ext\u00e9rieurs. Par exemple, \u00e0 l'annonce d'une bonne nouvelle comme une promotion ou une naissance, on peut ressentir de la joie tandis qu'un accident ou une urgence m\u00e9dicale peut entra\u00eener des \u00e9motions de peur, confusion et tristesse.", "type": "describer"}, {"content": "<ul><li>la joie<li> la surprise <li>la peur <li>l'ennui<li> la col\u00e8re <li> la tristesse <li> l'\u00e9nervement <li>la frustration <li> l'indiff\u00e9rence</li></ul>", "type": "text"}, {"content": "<span class=\"strong\">Marco</span> : Je ne sais pas ce qui m'a pris de m'\u00e9nerver comme \u00e7a. J'avais accumul\u00e9 pas mal de frustration par rapport \u00e0 mon boulot.", "type": "example"}, {"content": "<span class=\"strong\">Coraline</span> : Eh bien, promets-moi de te confier \u00e0 moi la prochaine fois, d'accord ? Ce n'est jamais bon de garder toute cette col\u00e8re \u00e0 l'int\u00e9rieur.<br>", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "s'\u00e9nerver", "type": "name"}, {"content": "s'irriter contre quelque chose ou quelqu'un", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Je ne sais pas ce qui m'a pris de m'\u00e9nerver comme \u00e7a.", "type": "example"}, {"content": "frn5le10ob05aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Ce sont les mots qu'on utilise quand on fait une promesse.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "se confier \u00e0 quelqu'un", "type": "name"}, {"content": "faire des confidences \u00e0 quelqu'un  ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : Promets-moi de te confier \u00e0 moi la prochaine fois,&nbsp;d'accord ? ", "type": "example"}, {"content": "frn5le10ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "la col\u00e8re", "type": "name"}, {"content": "\u00e9motion de rage qui se traduit par un emportement violent", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Ce n'est jamais bon de garder toute cette col\u00e8re \u00e0 l'int\u00e9rieur.", "type": "example"}, {"content": "frn5le10ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "garder ses \u00e9motions \u00e0 l'int\u00e9rieur", "type": "name"}, {"content": "ne pas partager ce que l'on ressent avec les autres", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : Marco a tendance \u00e0 garder ses \u00e9motions \u00e0 l'int\u00e9rieur.", "type": "example"}, {"content": "frn5le10ob05aud04", "type": "audio"}]}, {"type": "targe