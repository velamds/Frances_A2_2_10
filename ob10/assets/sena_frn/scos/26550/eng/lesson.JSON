{"content": "true", "type": "text"}], "correct": 1}, {"id": 1, "selected": 0, "_data": [{"content": "false", "type": "text"}], "correct": 0}]}, {"id": 1, "_data": [{"type": "question", "contents": [{"content": "frn5le10ob10re6aud02", "type": "audio"}, {"content": "Dina aide souvent avec la vaisselle.", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "true", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "false", "type": "text"}], "correct": 1}]}], "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Dina dit \u00e0 Lucien ce qu'elle fait chez elle."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Consignes :<span class=\"bullet\">\u00c9coutez les enregistrements audio.</span> <span class=\"bullet\">Appuyez sur VRAI si la phrase est vraie.</span><span class=\"bullet\"> Appuyez sur FAUX si la phrase est fausse."}]}], "template_override": 1}, {"id": 11, "type": "RSLT", "stimuli_ids": [], "questions": [{"id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}]}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!"}, "type": "feedback"}], "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"template_override": 1, "id": 0, "type": "welcome", "_data": [], "contents": [{}]}, {"id": 1, "type": "audio", "_data": [], "template_override": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "frn5le10ob10re2aud01", "coverimg": "frn5le10ob10re2img05.jpg", "images": [{"id": 0, "text": "", "image": "frn5le10ob10re2img05.jpg", "time": "0"}, {"id": 1, "text": "<span class=\"strong\">Marco</span> : Qu'est-ce que tu fais tous les jours, Coraline ? Je sais que tu travailles beaucoup, mais qu'en est-il du reste de la journ\u00e9e ? </br>\n<span class=\"strong\">Coraline</span> : Hum, je passe pas mal de temps \u00e0 penser \u00e0 toi\u2026 </br>\n<span class=\"strong\">Marco</span> : C'est bien \u00e7a. </br>\n<span class=\"strong\">Coraline</span> : J'aide aussi souvent que possible ma tante Eug\u00e9nie \u00e0 faire les courses, faire la lessive et le m\u00e9nage.", "image": "frn5le10ob10re2img05.jpg", "time": "100"}, {"id": 2, "text": "<span class=\"strong\">Marco</span> : Penses-tu que tu pourrais me pr\u00e9senter tante Eug\u00e9nie un jour ? Je meurs d'envie de la rencontrer. </br>\n<span class=\"strong\">Coraline</span> : Bien s\u00fbr. Nous avons un d\u00eener en famille tous les jeudis soir. </br> Voudrais-tu venir cette semaine ? </br>\n<span class=\"strong\">Marco</span> : G\u00e9nial ! Parfois je suis un peu nerveux quand je rencontre la famille de ma petite amie. Cela d\u00e9pend de combien je suis attach\u00e9 \u00e0 elle.", "image": "frn5le10ob10re2img05.jpg", "time": "15000"}, {"id": 3, "text": "<span class=\"strong\">Coraline</span> : \u00c0 quel point es-tu nerveux de rencontrer ma famille ?</br>\n<span class=\"strong\">Marco</span> : Tr\u00e8s !<br/>\n<span class=\"strong\">Coraline</span> : Est-ce que par hasard tu pourrais porter ton polo bleu ? Cette couleur te va si bien !</br>\n<span class=\"strong\">Marco</span> : Pas de probl\u00e8me... Je le laverai ce soir !", "image": "frn5le10ob10re2img05.jpg", "time": "35500"}]}}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Coraline rompt avec Marco", "type": "lesson_name"}, {"content": "La nouvelle normalit\u00e9", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 10, "type": "lesson"}, {"content": "A2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant identifie et d\u00e9crit des plans concernant l'organisation d'\u00e9v\u00e9nements.", "type": "primary"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_1"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_2"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_3"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_4"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_5"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_6"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_7"}, {"content": "L'apprenant comprend de l'information importante et rel\u00e8ve des aspects concernant l'attitude et l'intention des locuteurs dans des situations orales en fran\u00e7ais dans un \u00e9ventail de sujets communicatifs", "type": "secondary_8"}]}, {"content": "frn5le10ob10re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Le futur simple avec le verbe <span class=\"italic\">laver</span>"}, {"type": "describer", "content": "<span class=\"italic\">Laver</span> veut dire nettoyer quelque chose avec de l'eau et le plus souvent avec un produit sp\u00e9cial (savon, lessive, d\u00e9tergent, etc.). <br/>Lorsque l'on se lave soi-m\u00eame on utilise le verbe r\u00e9fl\u00e9chi : se laver. </br> Voici le verbe laver au futur simple :"}, {"type": "example", "content": "Je laverai mon polo ce soir !"}, {"type": "table", "content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Sujet\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Verbe\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"je\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"laverai\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tu\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"laveras\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"il/elle/on\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"lavera\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"nous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"laverons\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"laverez\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ils/elles\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"laveront\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "Attention : On utilise l'expression <span class=\"italic\">faire la lessive</span> sp\u00e9cifiquement quand on parle de nettoyer le linge de maison, les v\u00eatements."}, {"type": "example", "content": "Je ferai la lessive des draps en fin de journ\u00e9e."}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots qu'on utilise pour parler de la vie quotidienne.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "le polo ", "type": "name"}, {"content": "une chemise de sport en maille", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Est-ce que par hasard tu pourrais porter ton polo bleu ? Cette couleur te va si bien !", "type": "example"}, {"content": "frn5le10ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mourir d'envie de", "type": "name"}, {"content": "vouloir ou d\u00e9sirer ardemment quelque chose", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : Je meurs d'envie de rencontrer ta tante Eug\u00e9nie.", "type": "example"}, {"content": "frn5le10ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "\u00e0 quel point", "type": "name"}, {"content": "combien", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : \u00c0 quel point es-tu nerveux de rencontrer ma famille ?", "type": "example"}, {"content": "frn5le10ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "pas mal de temps", "type": "name"}, {"content": "beaucoup de temps", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : Je passe pas mal de temps \u00e0 penser \u00e0 toi.", "type": "example"}, {"content": "frn5le10ob10aud06", "type": "audio"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Le verbe <span class=\"italic\">d\u00e9pendre</span> "}, {"type": "describer", "content": "<span class=\"italic\">D\u00e9pendre</span> veut dire \u00eatre dans une relation de d\u00e9pendance mat\u00e9rielle ou psychologique \u00e0 l'\u00e9gard de quelqu'un. </br> On utilise le verbe <span class=\"italic\">d\u00e9pendre</span> avec la pr\u00e9position <span class=\"italic\">de</span> pour exprimer la possibilit\u00e9 ou l'incertitude."}, {"type": "example", "content": " J'aime aider autant que je peux car je ne veux pas d\u00e9pendre d'elle pour ces choses-l\u00e0."}, {"type": "example", "content": "La grand-m\u00e8re de Lucie n'aime d\u00e9pendre de personne pour ses activit\u00e9s quotidiennes."}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Posez des questions \u00e0 votre camarade sur les t\u00e2ches m\u00e9nag\u00e8res que chaque membre de sa famille accomplit \u00e0 la maison."}, {"type": "text", "content": "Faites une liste compl\u00e8te des t\u00e2ches m\u00e9nag\u00e8res qu'il (elle) accomplit, et faites la v\u00f4tre aussi. Comparez-les&nbsp;!"}, {"type": "text", "content": "\u00c9crivez un petit texte \u00e0 ce sujet et partagez-le avec la classe."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "Je pose des questions \u00e0 mon carmarade."}, {"type": "text", "content": "J'\u00e9cris un paragraphe comparant deux personnes."}, {"type": "text", "content": "Je parle de la vie quotidienne."}, {"type": "text", "content": "Je lis le paragraphe \u00e0 voix haute. "}]}, {"type": "target_word", "contents": [{"content": "attach\u00e9, attach\u00e9e", "type": "name"}, {"content": "int\u00e9ress\u00e9, d\u00e9vou\u00e9", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple : Parfois je suis un peu nerveux quand je rencontre la famille de ma petite amie. Cela d\u00e9pend de combien je suis attach\u00e9 \u00e0 elle.", "type": "example"}, {"content": "frn5le10ob10aud07", "type": "audio"}]}]}